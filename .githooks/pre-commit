#!/usr/bin/env bash

# ── Fichiers locaux sensibles ──
if git diff --cached --name-only | grep -qE "UserSettings/|\.env$"; then
    echo "❌ Tentative de commit de fichiers locaux (UserSettings, .env)"
    exit 1
fi

# ── Taille max des fichiers (50MB) ──
MAX_SIZE=$((50 * 1024 * 1024))
while IFS= read -r file; do
    if [ -f "$file" ]; then
        SIZE=$(wc -c < "$file")
        if [ "$SIZE" -gt "$MAX_SIZE" ]; then
            echo "❌ Fichier trop lourd : $file ($(( SIZE / 1024 / 1024 ))MB — max 50MB)"
            exit 1
        fi
    fi
done <<EOF
$(git diff --cached --name-only)
EOF